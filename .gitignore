# claude code local state
.claude/

# single binary build output (frontend embedded)
/artex
# intermediate files one-click update leaves next to the executable (staged file / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never commit it)
/jwt.key

# local environment generated by the Docker deployment (contains passwords/keys, do not commit)
.env

# event logs from scheduler runs/simulations (test output, do not commit)
*-events.csv

# bench benchmark files (local output, do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2